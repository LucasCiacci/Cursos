programa {
	
	funcao inicio() {
		escreva("{ EXERCÍCIO 005 - Média do Aluno }\n")

		real n1, n2, media

		escreva("Primeira nota: ")
		leia(n1)
		escreva("Segunda nota: ")
		leia(n2)

		media = (n1+n2)/2

		escreva("\n")
		escreva("\nAs notas do aluno foram ", n1, " e ", n2)
		escreva("\nA média final foi ", media)
		escreva("\n")		
	}
}
