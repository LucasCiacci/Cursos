programa {
	
	funcao inicio() {
		escreva("{ EXERCÍCIO 006 - Conversor de Medidas }\n")

		real metros

		escreva("Distância em metros: ")
		leia(metros)

		escreva("\n")
		escreva("\n--------- CONVERTENDO -----------")
		escreva("\n", metros/1000, " Km")
		escreva("\n", metros/100, " Hm")
		escreva("\n", metros/10, " Dam")
		escreva("\n", metros*10, " dm")
		escreva("\n", metros*100, " cm")
		escreva("\n", metros*1000, " mm")
		escreva("\n")
	}
}
