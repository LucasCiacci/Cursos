programa {
	
	funcao inicio() {
		/*
		inteiro n 
		caracter r
		enquanto (verdadeiro) {
			escreva("Valor: ")
			leia(n)

			escreva("Quer continuar? ")
			leia(r)
			se (r == 'N' ou r == 'n') {
				pare
			}
		}
		escreva("Usuário mandou parar...\n")
		*/
		cadeia nome
		inteiro idade
		enquanto (verdadeiro) {
			escreva("Nome: ")
			leia(nome)
			se (nome == "ACABOU") {
				pare
			}
			escreva("Idade: ")
			leia(idade)
		}
		escreva("Acabou o programa...\n")
	}
}
