programa {
	
	funcao inicio() {
		inteiro a = 7, b = 9
		escreva(a>=b)
		escreva("\n")
		escreva(a==b)
		escreva("\n")
		escreva(a<=b)
		escreva("\n")
		escreva(a!=b)
	}
}
