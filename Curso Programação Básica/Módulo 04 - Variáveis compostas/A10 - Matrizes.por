programa {
	
	funcao inicio() {
		inteiro x //Variável Simples
		inteiro y[5] //Variável composta (VETOR)
		inteiro z[3][2] //Variável composta (MATRIZ)

		x = 8
		y[3] = 7
		z[2][1] = 6 
		z[1][0] = 4

		escreva("FIM")
	}
}
